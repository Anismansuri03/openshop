  "private": false,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5",
      "tsconfig-paths": "^4.2.0",
      "sharp": "^0.35.5",
      "proxy-addr": "^2.0.8",
      "@grpc/grpc-js": "^1.14.5",
      "body-parser": "^1.20.9",
      "compression": "^1.8.2",
      "follow-redirects": "^1.16.1",
      "lodash": "^4.18.0",
      "multer": "^2.5.0",
      "source-map-js": "^1.2.2",
      "vite": "^7.3.7",
      "postcss": "^8.5.23",
      "postcss-selector-parser": "^6.1.5",
      "ajv@^8.0.0": "^8.18.0",
      "brace-expansion@^1.0.0": "^1.1.21",
      "brace-expansion@^5.0.0": "^5.0.12",
      "@graphql-tools/utils": "^12.0.2",
