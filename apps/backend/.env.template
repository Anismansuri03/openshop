STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
# Database URL. Pick your own database name (examples in the docs use
# maison_public_local). Never commit a filled-in copy of this file.
DATABASE_URL=

# Auth rate limiting (all optional; defaults shown are applied when unset).
# Requests to /auth/* are limited per client IP + method + path.
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_AUTH_WINDOW_MS=60000
# Set to the number of trusted reverse-proxy hops (0 = ignore
# X-Forwarded-For entirely, the safe default for direct exposure).
# RATE_LIMIT_TRUSTED_PROXY_HOPS=0

# Development payment provider (docs/PAYMENTS.md). The provider
# pp_dev-payment_default only SIMULATES payments and never processes real
# money. It refuses to boot when NODE_ENV=production unless this is set to
# "true" — an explicit acknowledgement that payments are simulated. Leave
# unset for normal development and tests.
# ENABLE_DEV_PAYMENT_PROVIDER=true

# --- Payments (G2) -------------------------------------------------------
# Local payment simulator (pp_sim-payment_default) webhook signing secret.
# Shared secret for SIMULATED deliveries only — never a real credential.
# Non-production runs fall back to a built-in local value; production
# refuses to boot the simulator without it (see validate-env.ts).
# SIM_PAYMENT_WEBHOOK_SECRET=

# Official Stripe provider (docs/PAYMENTS.md, docs/G2_SANDBOX_VALIDATION.md).
# Registers ONLY when STRIPE_API_KEY is set; when it is absent Stripe is
# simply unavailable — there is deliberately no fallback to a simulator.
# LIVE keys are hard-rejected outside NODE_ENV=production or without
# STRIPE_MODE=live, and API key without webhook secret is refused too.
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_MODE=test
