# Publishable API key for the Medusa backend. Required for the storefront to function.
# Learn how to create a publishable key: https://docs.medusajs.com/v2/resources/storefront-development/publishable-api-keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL of the Medusa backend API server
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Default region code to use for the storefront
NEXT_PUBLIC_DEFAULT_REGION=dk

# Base URL of the storefront — the single source for every absolute URL the app
# emits (metadataBase, Open Graph, sitemap.xml, robots.txt).
# Format: an absolute http(s) origin, no path/query/credentials, e.g.
#   https://shop.example.com
# NEXT_PUBLIC_ values are read at BUILD time — set this before `next build`.
# Production builds (NODE_ENV=production) REQUIRE a non-loopback origin and
# fail with a clear error if this is missing, malformed, or points at
# localhost/127.0.0.1/::1 — so canonical/OG URLs are never silently published
# for localhost. The localhost value below is for local development only
# (and is what local dev falls back to when the variable is unset).
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Reserved for an optional Stripe integration. This starter does NOT wire
# Stripe: checkout uses Medusa's built-in manual test provider (pp_system_default)
# and never processes real payments. Leave empty unless you add Stripe yourself.
NEXT_PUBLIC_STRIPE_KEY=

# Medusa Cloud S3 bucket hostname (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_HOSTNAME=

# Medusa Cloud S3 bucket path (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_PATHNAME=

# Node environment (development, production, etc.)
NODE_ENV=development
